DB_NAME=inmobiliaria_db
DB_USER=inmobiliaria
DB_PASSWORD=replace_with_a_strong_database_password
DB_ROOT_PASSWORD=replace_with_a_different_root_password
MYSQL_MIGRATOR_USER=nexora_migrator
MYSQL_MIGRATOR_PASSWORD=replace_with_a_strong_mysql_migrator_password
MYSQL_PORT=3306

# MongoDB principal. Para el entorno Docker use contraseñas fuertes con
# caracteres seguros para URL (letras, números, guion y guion bajo).
MONGO_DATABASE=nexora
MONGO_ROOT_USER=nexora_root
MONGO_ROOT_PASSWORD=replace_with_a_strong_mongodb_root_password
MONGO_APP_USER=nexora_app
MONGO_APP_PASSWORD=replace_with_a_strong_mongodb_app_password
MONGO_MIGRATOR_USER=nexora_migrator
MONGO_MIGRATOR_PASSWORD=replace_with_a_strong_mongodb_migrator_password
MONGO_PORT=27017

# Redis se utiliza para caché, bloqueos distribuidos e idempotencia.
REDIS_PASSWORD=replace_with_a_strong_redis_password
REDIS_PORT=6379
REDIS_DATABASE=0
CACHE_DEFAULT_TTL=10m
CACHE_KEY_PREFIX=nexora:

API_PORT=8080
FRONTEND_PORT=4200
MIGRATOR_PORT=8278
MIGRATOR_TELEMETRY_ENABLED=false
MYSQL_CONNECTOR_VERSION=8.3.0

# Mínimo 32 bytes. En producción debe almacenarse en un gestor de secretos.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

APP_ALLOWED_ORIGINS=http://localhost:4200
APP_STORAGE_PATH=./storage

# Solo para crear el primer administrador en una instalación nueva. Cambiar a
# false inmediatamente después de comprobar el primer inicio satisfactorio.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_EMPRESA_CODIGO=EMPRESA-DEMO
BOOTSTRAP_EMPRESA_NOMBRE=Empresa Inmobiliaria
BOOTSTRAP_EMPRESA_NIT=900000000-0
BOOTSTRAP_ADMIN_DOCUMENTO=1000000000
BOOTSTRAP_ADMIN_NOMBRES=Administrador
BOOTSTRAP_ADMIN_APELLIDOS=Principal
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_admin_password
