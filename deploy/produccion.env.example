# Variables de NEXORA CORE en el servidor (staging o producción).
#
# Copie este archivo a /opt/nexora/.env en el servidor, complételo y deje permisos 600:
#   chmod 600 /opt/nexora/.env
# Nunca lo suba al repositorio. Genere cada contraseña con:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-32
# (solo letras y números: así sirven también dentro de la URL de MongoDB).

# Dominio público (debe apuntar a la Elastic IP antes del primer arranque) y correo para Let's Encrypt.
DOMINIO=staging.ejemplo.com
ACME_EMAIL=equipo@ejemplo.com

# Versión a desplegar (tag de las imágenes en GHCR). "latest" = la última publicada.
NEXORA_VERSION=latest

# MySQL
DB_NAME=inmobiliaria_db
DB_USER=inmobiliaria
DB_PASSWORD=
DB_ROOT_PASSWORD=
MYSQL_MIGRATOR_PASSWORD=

# MongoDB
MONGO_DATABASE=nexora
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_MIGRATOR_PASSWORD=

# Redis
REDIS_PASSWORD=

# Firma de los tokens: 48 caracteres aleatorios o más (openssl rand -base64 48).
JWT_SECRET=

# Primer administrador: true SOLO en el primer arranque de una base nueva; después false.
# Al entrar la primera vez la aplicación obliga a cambiar esta contraseña.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_EMPRESA_CODIGO=EYC-ALTAMAR
BOOTSTRAP_EMPRESA_NOMBRE=E&C Altamar Constructora
BOOTSTRAP_EMPRESA_NIT=
BOOTSTRAP_ADMIN_DOCUMENTO=
BOOTSTRAP_ADMIN_NOMBRES=Administrador
BOOTSTRAP_ADMIN_APELLIDOS=NEXORA
BOOTSTRAP_ADMIN_USERNAME=SUPERADMIN
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Ajustes de capacidad (valores por defecto pensados para m7i.xlarge, 4 vCPU y 16 GiB).
# DB_POOL_MAX_SIZE=30
# MONGO_POOL_MAX=100
# MYSQL_BUFFER_POOL=2G
# MONGO_CACHE_GB=1.5
# API_MEMORIA=4g
