# Capacidad para un servidor de 4 GiB y 2 vCPU (Lightsail "Medium" de USD 24 al mes).
#
# Se agrega al final del .env del servidor; reemplaza los valores por defecto, pensados para
# una m7i.xlarge de 16 GiB:
#   cat deploy/capacidad-4gb.env >> /opt/nexora/.env
#
# Reparto de la memoria (límite del contenedor → uso normal medido en el CI):
#   API 1,4 GiB (Java ~850 MB de heap) · MySQL 768 MB · MongoDB 640 MB · Redis 128 MB
#   Caddy 128 MB · frontend 96 MB · Prometheus 512 MB · Grafana 256 MB · cAdvisor 192 MB
#   Los límites son techos. En el CI, después de la prueba de humo, todo junto usó 1,3 GiB
#   (API 435 MB, MySQL 262 MB, Prometheus 193 MB, MongoDB 120 MB). Con datos reales se espera
#   entre 1,5 y 2,5 GiB, y queda margen para el sistema.
# Además, deploy/crear-swap.sh deja 2 GiB de swap por si hay un pico (respaldos, despliegues).
#
# Pensado para el uso actual (decenas de usuarios a la vez). La prueba de carga de 100 usuarios
# en staging usó menos de 0,4 vCPU, dentro de lo que Lightsail sostiene sin agotar ráfagas.

# MySQL: 256 MB de caché de InnoDB, sin performance_schema (ahorra ~400 MB) y menos conexiones.
MYSQL_BUFFER_POOL=256M
MYSQL_MAX_CONNECTIONS=60
MYSQL_PERFORMANCE_SCHEMA=OFF
MYSQL_MEMORIA=768m

# MongoDB: caché mínima de WiredTiger.
MONGO_CACHE_GB=0.25
MONGO_MEMORIA=640m
MONGO_POOL_MAX=30
MONGO_POOL_MIN=2
# Chequeo de salud cada minuto: cada uno abre mongosh y gasta ~1 s de CPU.
MONGO_SALUD_INTERVALO=60s

# Redis: solo caché y contadores efímeros.
REDIS_MAXMEMORY=64mb
REDIS_MEMORIA=128m

# API: 60 % del límite para el heap; el resto para metaspace, hilos y código compilado.
API_MEMORIA=1408m
API_JAVA_OPTS=-XX:MaxRAMPercentage=60.0 -XX:+UseSerialGC -Xss512k -XX:ReservedCodeCacheSize=96m -XX:MaxMetaspaceSize=224m
DB_POOL_MAX_SIZE=12
DB_POOL_MIN_IDLE=2
TOMCAT_MAX_THREADS=60

# Frontend y Caddy.
FRONTEND_MEMORIA=96m
CADDY_MEMORIA=128m

# Monitoreo: 7 días de métricas y cAdvisor cada 30 s (menos CPU).
PROMETHEUS_RETENCION=7d
PROMETHEUS_MEMORIA=512m
CADVISOR_INTERVALO=30s
