        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"nexora-api\"}[1m])))",
          "legendFormat": "{{method}} {{uri}}"
